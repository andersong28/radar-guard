<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema escuro do sistema: sem AppCompat, sem Material Components, sem dependencia. -->
    <style name="RGTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0F14</item>
        <item name="android:colorAccent">#4EA8DE</item>
        <item name="android:textColorPrimary">#F2F6FA</item>
        <item name="android:textColorSecondary">#7C8DA6</item>
        <item name="android:statusBarColor">#0B0F14</item>
    </style>

    <style name="RGLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">#F2F6FA</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RGHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#7C8DA6</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="RGInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#F2F6FA</item>
        <item name="android:textColorHint">#4A5A70</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
